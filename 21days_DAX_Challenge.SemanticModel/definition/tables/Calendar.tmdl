table Calendar
	lineageTag: ead946d6-26e3-46ff-8680-d836ea32924b

	measure 'Lowest Avg' =
			
			VAR TopProduct =
			    TOPN(
			        1,
			        Products,
			        CALCULATE(AVERAGE(OrderDetail[Quantity])),
			        ASC
			    )
			RETURN
			    CALCULATE(
			        SELECTEDVALUE(Products[ProductName]),
			        TopProduct
			    )
		lineageTag: 8da1020e-ca45-4224-b0e2-93ce4d946090

